{
  "title": "Homelab — batman01",
  "uid": "homelab-overview",
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "CPU del nodo batman01",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "pve_cpu_usage_ratio{id=\"node/batman01\"}", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "Memoria del nodo batman01",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "red", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "pve_memory_usage_bytes{id=\"node/batman01\"} / pve_memory_size_bytes{id=\"node/batman01\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Estado de VMs/LXCs (1 = corriendo)",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        { "expr": "pve_up{id=~\"(lxc|qemu)/.*\"}", "refId": "A", "format": "table", "instant": true }
      ]
    },
    {
      "id": 4,
      "title": "Uso de disco por storage (%)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "pve_disk_usage_bytes{id=~\"storage/.*\"} / pve_disk_size_bytes{id=~\"storage/.*\"}",
          "legendFormat": "{{id}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "CPU del LXC de observabilidad (node_exporter)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))",
          "legendFormat": "cpu",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Vault activo",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "activo", "color": "green" } } },
            { "type": "value", "options": { "0": { "text": "inactivo", "color": "red" } } }
          ]
        },
        "overrides": []
      },
      "targets": [
        { "expr": "vault_core_active", "refId": "A" }
      ]
    }
  ]
}
